// This is your Prisma schema file for SQLite (development)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: SQLite/Prisma can't enforce enums at the DB level for this project,
// so allowed values are documented next to the field and enforced at the
// application layer via the TS enums in `src/types.ts`. Keep them in sync.

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  username      String    @unique
  fullName      String?
  bio           String?
  avatarUrl     String?
  university    String?
  country       String?
  githubUrl     String?
  portfolioUrl  String?
  linkedinUrl   String?
  interests     String?
  skillsJson    String?

  skills         UserSkill[]
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  messages       Message[]
  notifications  Notification[]
  collaborations Collaboration[]
  savedPosts     SavedPost[]
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  following        Follow[]        @relation("Follower")
  followers        Follow[]        @relation("Following")

  reputation  Int     @default(0)
  isVerified  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkId])
  @@index([username])
  @@index([email])
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String
  description String?

  users      UserSkill[]
  postSkills PostSkill[]

  @@index([category])
  @@index([name])
}

model UserSkill {
  id               String @id @default(cuid())
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  skill            Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          String
  proficiencyLevel String @default("BEGINNER") // ProficiencyLevel
  endorsements     Int    @default(0)
  createdAt        DateTime @default(now())

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Post {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String              // PostType
  status        String   @default("IDEATION")  // ProjectStatus
  visibility    String   @default("PUBLIC")    // PostVisibility
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requiredSkills PostSkill[]
  tags          String?
  attachments   String?
  teamSize      Int?
  deadline      DateTime?
  budget        Int?
  repositoryUrl String?
  comments      Comment[]
  likes         Like[]
  savedBy       SavedPost[]
  discussion    Discussion?
  collaborations Collaboration[]
  isPinned      Boolean  @default(false)
  shareCount    Int      @default(0)
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([visibility])
}

model SavedPost {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
}

model PostSkill {
  id      String @id @default(cuid())
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String

  @@unique([postId, skillId])
  @@index([postId])
  @@index([skillId])
}

model Discussion {
  id           String   @id @default(cuid())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String   @unique
  name         String
  description  String?
  type         String   @default("PROJECT") // DiscussionType
  members      DiscussionMember[]
  messages     Message[]
  pinnedMessages String?
  messageCount Int      @default(0)
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([postId])
  @@index([createdAt])
}

model DiscussionMember {
  id           String     @id @default(cuid())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String
  userId       String
  role         String     @default("MEMBER") // MemberRole
  lastReadAt   DateTime   @default(now())
  joinedAt     DateTime   @default(now())

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
}

model Message {
  id           String     @id @default(cuid())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  content      String
  type         String     @default("TEXT") // MessageType
  codeBlock    CodeBlock?
  reactions    Reaction[]
  isEdited     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([discussionId])
  @@index([authorId])
  @@index([createdAt])
}

model CodeBlock {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String  @unique
  language  String
  code      String
  filename  String?
}

model Reaction {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  emoji     String
  count     Int     @default(1)

  @@unique([messageId, emoji])
  @@index([messageId])
}

model Comment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  likes     Like[]
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([userId])
  @@index([postId])
  @@index([commentId])
}

model Collaboration {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    String   @default("PENDING") // CollaborationStatus
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([status])
}

model DirectMessage {
  id         String   @id @default(cuid())
  sender     User     @relation("SentMessages",     fields: [senderId],    references: [id], onDelete: Cascade)
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId],  references: [id], onDelete: Cascade)
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // NotificationType
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([read])
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetType   String   // ReportTargetType: POST | COMMENT | USER
  targetId     String
  reason       String
  details      String?
  status       String   @default("PENDING") // ReportStatus: PENDING | REVIEWED | DISMISSED
  createdAt    DateTime @default(now())

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}
